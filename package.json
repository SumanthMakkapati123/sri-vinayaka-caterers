{
  "name": "sri-vinayaka-caterers", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs", "dev": "npm run build && wrangler dev",
    "test": "node --test tests/*.test.mjs", "test:browser": "node tests/browser.mjs",
    "db:local": "wrangler d1 migrations apply DB --local", "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy", "check:deploy": "npm run build && wrangler deploy --dry-run",
    "owner:password": "node scripts/password.mjs",
    "site:pause": "node scripts/pause.mjs",
    "site:resume": "node scripts/resume.mjs"
  },
  "devDependencies": { "wrangler": "^4.0.0", "@playwright/test": "^1.55.0" }
}
